 "lines": [
  {
   "scene": 1,
   "speaker": "leo",
   "text": "Mott. Con un solo prompt, Claude me arma la app.",
   "tag": "[confident]",
   "start": 3.4,
   "end": 6.92
  },
  {
   "scene": 2,
   "speaker": "mott",
   "text": "Antes de que escriba código… probá grill-me, de Matt Pocock.",
   "tag": "[calm]",
   "start": 7.52,
   "end": 12.16
  },
  {
   "scene": 3,
   "speaker": "leo",
   "text": "¿Y cómo lo instalo?",
   "tag": "[curious]",
   "start": 14.06,
   "end": 15.74
  },
  {
   "scene": 4,
   "speaker": "mott",
   "text": "Un comando, en Claude Code.",
   "tag": "[matter-of-fact]",
   "start": 16.14,
   "end": 18.06
  },
  {
   "scene": 5,
   "speaker": "mott",
   "text": "Después escribís barra grill-me, y tu idea.",
   "tag": "[calm]",
   "start": 20.26,
   "end": 24.66
  },
  {
   "scene": 6,
   "speaker": "leo",
   "text": "¡Pará! ¿Me está haciendo preguntas?",
   "tag": "[surprised]",
   "start": 26.86,
   "end": 29.26
  },
  {
   "scene": 7,
   "speaker": "mott",
   "text": "Seis. Y cada una trae su respuesta recomendada.",
   "tag": "[matter-of-fact]",
   "start": 31.06,
   "end": 34.42
  },
  {
   "scene": 8,
   "speaker": "leo",
   "text": "Ok… ok… no. Quiero que se sincronice.",
   "tag": "[thinking]",
   "start": 35.82,
   "end": 40.54
  },
  {
   "scene": 9,
   "speaker": "mott",
   "text": "Y con ese «no», cambió el plan.",
   "tag": "[calm]",
   "start": 41.34,
   "end": 43.98
  },
  {
   "scene": 10,
   "speaker": "leo",
   "text": "¿Y cuándo escribe código?",
   "tag": "[curious]",
   "start": 46.18,
   "end": 48.18
  },
  {
   "scene": 11,
   "speaker": "mott",
   "text": "Cuando no queda ninguna decisión abierta.",
   "tag": "[warmly]",
   "start": 48.58,
   "end": 51.22
  },
  {
   "scene": 12,
   "speaker": "leo",
   "text": "Es más lento.",
   "tag": "[skeptical]",
   "start": 53.82,
   "end": 55.42
  },
  {
   "scene": 13,
   "speaker": "mott",
   "text": "Más lento. Pero arma tu app, no la que se imaginó.",
   "tag": "[dry]",
   "start": 55.82,
   "end": 59.98
  }
 ],
