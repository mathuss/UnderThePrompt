 "lines": [
  {
   "scene": 1,
   "speaker": "leo",
   "text": "Mott. One prompt, and my app ships tonight.",
   "start": 0.15,
   "end": 2.518
  },
  {
   "scene": 2,
   "speaker": "mott",
   "text": "What's the prompt?",
   "start": 2.868,
   "end": 3.871
  },
  {
   "scene": 3,
   "speaker": "leo",
   "text": "Build me a habit tracker.",
   "start": 4.121,
   "end": 5.678
  },
  {
   "scene": 4,
   "speaker": "mott",
   "text": "For who?",
   "start": 5.978,
   "end": 6.703
  },
  {
   "scene": 5,
   "speaker": "leo",
   "text": "For… people.",
   "start": 7.003,
   "end": 7.878
  },
  {
   "scene": 5,
   "speaker": "leo",
   "text": "With habits.",
   "start": 8.178,
   "end": 9.031
  },
  {
   "scene": 6,
   "speaker": "mott",
   "text": "Where do the habits get saved?",
   "start": 9.231,
   "end": 10.618
  },
  {
   "scene": 7,
   "speaker": "leo",
   "text": "In the… in the app.",
   "start": 10.818,
   "end": 12.077
  },
  {
   "scene": 8,
   "speaker": "mott",
   "text": "And if they miss a day?",
   "start": 12.197,
   "end": 13.178
  },
  {
   "scene": 9,
   "speaker": "leo",
   "text": "I don't know.",
   "start": 14.078,
   "end": 15.102
  },
  {
   "scene": 10,
   "speaker": "leo",
   "text": "Why are you grilling me?",
   "start": 15.602,
   "end": 16.967
  },
  {
   "scene": 11,
   "speaker": "mott",
   "text": "Because your agent won't.",
   "start": 17.217,
   "end": 18.476
  },
  {
   "scene": 11,
   "speaker": "mott",
   "text": "It just builds.",
   "start": 18.726,
   "end": 19.686
  },
  {
   "scene": 12,
   "speaker": "leo",
   "text": "That's what I want.",
   "start": 19.936,
   "end": 21.109
  },
  {
   "scene": 13,
   "speaker": "mott",
   "text": "It builds its guess.",
   "start": 21.359,
   "end": 22.469
  },
  {
   "scene": 13,
   "speaker": "mott",
   "text": "Not your app.",
   "start": 22.769,
   "end": 23.601
  },
  {
   "scene": 14,
   "speaker": "mott",
   "text": "There's a skill for this.",
   "start": 24.151,
   "end": 25.303
  },
  {
   "scene": 14,
   "speaker": "mott",
   "text": "Grill me.",
   "start": 25.553,
   "end": 26.385
  },
  {
   "scene": 14,
   "speaker": "mott",
   "text": "Free.",
   "start": 26.585,
   "end": 27.246
  },
  {
   "scene": 15,
   "speaker": "leo",
   "text": "A skill?",
   "start": 27.546,
   "end": 28.293
  },
  {
   "scene": 16,
   "speaker": "mott",
   "text": "A text file of instructions.",
   "start": 28.493,
   "end": 30.114
  },
  {
   "scene": 16,
   "speaker": "mott",
   "text": "Your agent reads it.",
   "start": 30.314,
   "end": 31.466
  },
  {
   "scene": 17,
   "speaker": "leo",
   "text": "And it does what?",
   "start": 31.766,
   "end": 32.747
  },
  {
   "scene": 18,
   "speaker": "mott",
   "text": "It interviews you.",
   "start": 32.947,
   "end": 34.014
  },
  {
   "scene": 18,
   "speaker": "mott",
   "text": "Until no decision is left open.",
   "start": 34.264,
   "end": 36.12
  },
  {
   "scene": 19,
   "speaker": "leo",
   "text": "Sounds slow.",
   "start": 36.47,
   "end": 37.515
  },
  {
   "scene": 20,
   "speaker": "mott",
   "text": "It is.",
   "start": 37.715,
   "end": 38.441
  },
  {
   "scene": 20,
   "speaker": "mott",
   "text": "Slower than build it.",
   "start": 38.641,
   "end": 39.793
  },
  {
   "scene": 21,
   "speaker": "mott",
   "text": "But every question brings its answer.",
   "start": 40.143,
   "end": 42.02
  },
  {
   "scene": 21,
   "speaker": "mott",
   "text": "You say yes.",
   "start": 42.22,
   "end": 43.159
  },
  {
   "scene": 22,
   "speaker": "leo",
   "text": "And what I don't know?",
   "start": 43.459,
   "end": 44.717
  },
  {
   "scene": 23,
   "speaker": "mott",
   "text": "Facts, it looks up itself.",
   "start": 44.917,
   "end": 46.261
  },
  {
   "scene": 23,
   "speaker": "mott",
   "text": "Decisions are yours.",
   "start": 46.461,
   "end": 47.72
  },
  {
   "scene": 24,
   "speaker": "leo",
   "text": "Yes.",
   "start": 48.32,
   "end": 48.946
  },
  {
   "scene": 24,
   "speaker": "leo",
   "text": "Yes.",
   "start": 49.246,
   "end": 49.846
  },
  {
   "scene": 24,
   "speaker": "leo",
   "text": "No.",
   "start": 50.546,
   "end": 51.25
  },
  {
   "scene": 24,
   "speaker": "leo",
   "text": "Wait.",
   "start": 51.5,
   "end": 52.226
  },
  {
   "scene": 25,
   "speaker": "leo",
   "text": "Done. Your turn.",
   "start": 52.826,
   "end": 53.978
  },
  {
   "scene": 25,
   "speaker": "leo",
   "text": "Why the lamp?",
   "start": 54.278,
   "end": 55.323
  },
  {
   "scene": 27,
   "speaker": "leo",
   "text": "Recommended answer: you don't know.",
   "start": 57.323,
   "end": 59.35
  },
  {
   "scene": 28,
   "speaker": "mott",
   "text": "Yes.",
   "start": 60.25,
   "end": 60.911
  }
