 "lines": [
  {
   "scene": 1,
   "speaker": "leo",
   "text": "Mott, tengo una idea: una app para seguir mis hábitos.",
   "tag": "[excited]",
   "start": 3.4,
   "end": 7.0
  },
  {
   "scene": 2,
   "speaker": "leo",
   "text": "Se la pido a Claude y en un minuto la tengo.",
   "tag": "[confident]",
   "start": 7.4,
   "end": 9.96
  },
  {
   "scene": 3,
   "speaker": "leo",
   "text": "¡Listo! Mañana la uso desde el celu.",
   "tag": "[happy]",
   "start": 11.56,
   "end": 13.88
  },
  {
   "scene": 4,
   "speaker": "mott",
   "text": "Mmm… esa app no sale de esta compu.",
   "tag": "[skeptical]",
   "start": 15.08,
   "end": 18.36
  },
  {
   "scene": 5,
   "speaker": "leo",
   "text": "¿Cómo que no?",
   "tag": "[surprised]",
   "start": 19.96,
   "end": 21.08
  },
  {
   "scene": 6,
   "speaker": "mott",
   "text": "Nunca te preguntó dónde la ibas a usar. Adivinó.",
   "tag": "[calm]",
   "start": 21.38,
   "end": 24.9
  },
  {
   "scene": 7,
   "speaker": "mott",
   "text": "Pero tengo justo lo que necesitás: grill-me, de Matt Pocock.",
   "tag": "[warmly]",
   "start": 25.5,
   "end": 29.82
  },
  {
   "scene": 8,
   "speaker": "leo",
   "text": "¿Cómo funciona esto?",
   "tag": "[curious]",
   "start": 31.42,
   "end": 33.02
  },
  {
   "scene": 9,
   "speaker": "mott",
   "text": "Antes de escribir código, te entrevista.",
   "tag": "[calm]",
   "start": 33.32,
   "end": 35.88
  },
  {
   "scene": 10,
   "speaker": "mott",
   "text": "Cada pregunta trae su respuesta recomendada. Vos decís ok, o la cambiás.",
   "tag": "[calm]",
   "start": 37.08,
   "end": 42.28
  },
  {
   "scene": 11,
   "speaker": "leo",
   "text": "¿Y cómo lo uso?",
   "tag": "[curious]",
   "start": 43.88,
   "end": 45.32
  },
  {
   "scene": 12,
   "speaker": "mott",
   "text": "Lo instalás con un comando…",
   "tag": "[matter-of-fact]",
   "start": 45.62,
   "end": 47.38
  },
  {
   "scene": 13,
   "speaker": "mott",
   "text": "…y escribís barra grill-me, con tu idea.",
   "tag": "[matter-of-fact]",
   "start": 49.38,
   "end": 52.34
  },
  {
   "scene": 14,
   "speaker": "leo",
   "text": "La primera, ok. La segunda… no: la quiero en el celu y en la compu. El resto, ok.",
   "tag": "[thinking]",
   "start": 54.14,
   "end": 61.66
  },
  {
   "scene": 15,
   "speaker": "mott",
   "text": "Y con ese «no», cambió el plan.",
   "tag": "[calm]",
   "start": 62.26,
   "end": 65.06
  },
  {
   "scene": 16,
   "speaker": "leo",
   "text": "O sea que la primera vez… construyó lo que se imaginó.",
   "tag": "[thinking]",
   "start": 67.06,
   "end": 71.06
  },
  {
   "scene": 17,
   "speaker": "mott",
   "text": "Y esta vez, lo que vos querías. Primero preguntas, después código.",
   "tag": "[warmly]",
   "start": 71.56,
   "end": 76.44
  }
 ],
